{
  "arch": "x86_64",
  "archive-format": "darwin",
  "binary-format": "mach-o",
  "cpu": "x86-64",
  "data-layout": "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "debuginfo-kind": "dwarf-dsym",
  "disable-redzone": true,
  "dynamic-linking": false,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "executables": false,
  "features": "-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,+soft-float",
  "frame-pointer": "always",
  "has-thread-local": false,
  "is-like-darwin": true,
  "linker-flavor": "darwin-cc",
  "linker-is-gnu": false,
  "llvm-target": "x86_64-apple-macosx",
  "max-atomic-width": 64,
  "metadata": {
    "description": "x86_64 macOS kernel extension (clang -mkernel equivalent, soft-float)",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "os": "macos",
  "panic-strategy": "abort",
  "position-independent-executables": false,
  "relocation-model": "static",
  "rustc-abi": "softfloat",
  "split-debuginfo": "packed",
  "stack-probes": {
    "kind": "inline"
  },
  "target-pointer-width": 64,
  "vendor": "apple"
}
