<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenCore Kernel -> Add entries, in this order (Lilu first).
  MtkWirelessWifi and MtkWirelessBT are independent: either can be disabled.
  Phase 0 builds only run a self-test; keep SimpleMtkWlan/SimpleMtkBtFw
  enabled for working Wi-Fi and Bluetooth until phase 1.
-->
<plist version="1.0">
<array>
	<dict>
		<key>Arch</key>
		<string>x86_64</string>
		<key>BundlePath</key>
		<string>Lilu.kext</string>
		<key>Comment</key>
		<string>Lilu (needed by MtkWirelessBT)</string>
		<key>Enabled</key>
		<true/>
		<key>ExecutablePath</key>
		<string>Contents/MacOS/Lilu</string>
		<key>MaxKernel</key>
		<string></string>
		<key>MinKernel</key>
		<string></string>
		<key>PlistPath</key>
		<string>Contents/Info.plist</string>
	</dict>
	<dict>
		<key>Arch</key>
		<string>x86_64</string>
		<key>BundlePath</key>
		<string>MtkWirelessWifi.kext</string>
		<key>Comment</key>
		<string>MediaTek MT7921/MT7922 Wi-Fi</string>
		<key>Enabled</key>
		<true/>
		<key>ExecutablePath</key>
		<string>Contents/MacOS/MtkWirelessWifi</string>
		<key>MaxKernel</key>
		<string></string>
		<key>MinKernel</key>
		<string></string>
		<key>PlistPath</key>
		<string>Contents/Info.plist</string>
	</dict>
	<dict>
		<key>Arch</key>
		<string>x86_64</string>
		<key>BundlePath</key>
		<string>MtkWirelessBT.kext</string>
		<key>Comment</key>
		<string>MediaTek MT7921/MT7922 Bluetooth</string>
		<key>Enabled</key>
		<true/>
		<key>ExecutablePath</key>
		<string>Contents/MacOS/MtkWirelessBT</string>
		<key>MaxKernel</key>
		<string></string>
		<key>MinKernel</key>
		<string></string>
		<key>PlistPath</key>
		<string>Contents/Info.plist</string>
	</dict>
</array>
</plist>
